# UrbanFlow Environment Configuration
PROJECT_NAME="UrbanFlow - Smart City Traffic & Road Accident Prediction Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Default uses local SQLite for zero-setup execution.
# For production PostgreSQL + PostGIS, use:
# DATABASE_URL="postgresql://urbanflow_user:urbanflow_secret@localhost:5432/urbanflow_db"
DATABASE_URL="sqlite:///./urbanflow.db"

# Server Host and Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Target Demonstration Region
DEFAULT_REGION="Mumbai & Navi Mumbai Metropolitan Area"
DEFAULT_LATITUDE=19.0760
DEFAULT_LONGITUDE=72.8777
DEFAULT_ZOOM=11

# ML Model Paths
ML_MODELS_DIR="./ml_models"
DATASETS_DIR="./datasets/sample"

